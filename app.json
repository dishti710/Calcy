{
  "expo": {
    "name": "Calcy",
    "slug": "calcy",
    "version": "1.0.0",
    "sdkVersion": "50.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "guardian",
    "backgroundColor": "#f5f3ff",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f3ff"
    },
    "ios": {
      "supportsTabletMode": false,
      "bundleIdentifier": "com.guardian.safety",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Guardian needs your location to keep you safe",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Guardian tracks your location even when closed for emergencies",
        "NSMicrophoneUsageDescription": "Guardian records audio to detect emergency keywords",
        "NSPhotoLibraryUsageDescription": "Guardian saves security recordings to your library",
        "NSPhotoLibraryAddUsageDescription": "Guardian needs to save emergency recordings",
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SEND_SMS",
        "android.permission.READ_CONTACTS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.guardian.safety",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5f3ff"
      },
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Guardian to access your location for safety",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8b5cf6"
        }
      ],
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
